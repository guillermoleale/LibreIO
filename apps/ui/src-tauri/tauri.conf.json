{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LibreIO",
  "version": "1.2.0",
  "identifier": "ar.edu.utn.frro.libreio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "LibreIO",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "appimage"],
    "category": "Education",
    "shortDescription": "Software libre y didáctico de Investigación Operativa",
    "longDescription": "LibreIO reemplaza GLP, LINDO y WinQSB en la enseñanza de Investigación Operativa: método gráfico, simplex con traza completa, sensibilidad y reportes de texto.",
    "publisher": "Cátedra de Investigación Operativa, UTN FRRo",
    "copyright": "GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    },
    "linux": {
      "deb": {
        "section": "education"
      }
    }
  },
  "mainBinaryName": "libreio"
}
